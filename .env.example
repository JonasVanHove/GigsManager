# ────────────────────────────────────────────────────────────────────────────────
# GigsManager — Environment Variables
# ────────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Get database connection strings from:
#   Supabase Dashboard → Project Settings → Database → Connection string
#
#   • "Transaction pooler" → DATABASE_URL  (port 6543, pgbouncer=true)
#   • "Session pooler"     → DIRECT_URL    (port 5432, for migrations)
# ────────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# ── Supabase API (for keep-alive & future auth) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ── Server-side admin (REQUIRED in production) ───────────────────────────────
# Server-only secret used to verify Supabase JWTs (auth-helpers) and manage auth
# users. NEVER expose it to the browser. In the browser bundle it is undefined.
# Source: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Public app URL (REQUIRED in production) ──────────────────────────────────
# Absolute origin used to build absolute links: band invite/QR links
# (src/lib/band-invites.ts), calendar feed URLs and email links. Must match the
# deployed origin exactly, no trailing slash.
NEXT_PUBLIC_APP_URL="https://gigsmanager.app"

# --- AI features (Groq) -----------------------------------------------------------
# Optional. Without this key the AI endpoints return 503 and the rest of the
# app works normally. Used by:
#   - Gig documents + 'State of Play' summary (PDF/PNG/JPG -> Groq vision + text)
#   - Setlist import from text or a photo (OCR via llama-3.2-11b-vision-preview)
#   - Setlist flow & energy analysis (running order, key transitions)
#   - Smart day schedule generator (venue logistics -> departure/stage prep)
#   - Organizer message drafts (rider check, arrival, thank you / invoice)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=""

# ── Email (optional) ─────────────────────────────────────────────────────────
# Transactional auth emails (welcome / verification) via Resend. Without a key
# the /api/auth-webhook route logs but does not send mail.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""

# ── Supabase Auth webhook (optional, only when e-mails are enabled) ───────────
# Signing secret from the Supabase Database Webhook that posts to
# /api/auth-webhook. Verified (HMAC) before any mail is sent.
SUPABASE_WEBHOOK_SECRET=""

# ── Public demo account (optional) ───────────────────────────────────────────
# The /demo instant login signs visitors into a SHARED, public account without
# credentials, so these values are intentionally client-visible (NEXT_PUBLIC_*).
# Never store real data in the demo account. Disable entirely in production with
# NEXT_PUBLIC_DEMO_ENABLED="false" if you self-host and don't want a demo.
NEXT_PUBLIC_DEMO_EMAIL="demo@gigsmanager.app"
NEXT_PUBLIC_DEMO_PASSWORD="Demo1234!"
NEXT_PUBLIC_DEMO_ENABLED="true"


    "i18next-browser-languagedetector": "^8.2.1",
    "moment": "^2.30.1",
    "next": "14.2.15",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "resend": "^6.9.2",
    "svix": "^1.85.0"

// This is your generated Prisma schema.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Critical: Include both native (local dev) and rhel-openssl-3.0.x (Netlify Linux)
  // Netlify uses Amazon Linux 2 which requires rhel-openssl-3.0.x binary target
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  // Ensure client is generated for use in serverless functions
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
}

model Gig {
  id                         String          @id @default(cuid())
  eventName                  String
  date                       DateTime
  performers                 String
  numberOfMusicians          Int
  performanceFee             Float
  technicalFee               Float           @default(0)
  managerBonusType           String          @default("fixed")
  managerBonusAmount         Float           @default(0)
  paymentReceived            Boolean         @default(false)
  paymentReceivedDate        DateTime?
  bandPaid                   Boolean         @default(false)
  bandPaidDate               DateTime?
  notes                      String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  userId                     String
  claimPerformanceFee        Boolean         @default(true)
  claimTechnicalFee          Boolean         @default(true)
  technicalFeeClaimAmount    Float?
  managerHandlesDistribution Boolean         @default(true)
  advanceReceivedByManager   Float           @default(0)
  advanceToMusicians         Float           @default(0)
  isCharity                  Boolean         @default(false)
  bookingDate                DateTime        @default(now())
  managerPerformanceAmount   Float?
  performanceDistribution    String          @default("equal")
  managerPerforms            Boolean         @default(true)
  performanceLineup          String?
  setlistId                  String?
  isTentative                Boolean         @default(false)
  performanceFeeUnknown      Boolean         @default(false)
  /// Cached "State of Play" summary generated by Groq (JSON string).
  aiSummary                  String?         @db.Text
  aiSummaryAt                DateTime?
  /// Cached day schedule generated by Groq (JSON string).
  aiSchedule                 String?         @db.Text
  aiScheduleAt               DateTime?
  // --- Logistics inputs (drive the AI schedule generator) ---
  venueName                  String?
  venueLocation              String?         @db.Text
  /// Times are stored as "HH:MM" strings: they are local to the venue, and
  /// converting them to a timestamp here would be wrong across time zones/DST.
  soundcheckTime             String?
  doorsOpenTime              String?
  performanceDurationMinutes Int?
  gearSetupNotes             String?         @db.Text
  // --- Organizer / technician contact (used by the message drafter) ---
  organizerName              String?
  organizerEmail             String?
  organizerPhone             String?
  bandId                     String?         // Direct link to band
  /// Bandmates normally see the money (fees, bonuses), because transparent
  /// terms are the point of sharing. The owner can opt a specific gig out.
  isFinancialHidden          Boolean         @default(false)
  setlist                    Setlist?        @relation(fields: [setlistId], references: [id])
  user                       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  band                       bands?          @relation(fields: [bandId], references: [id])
  bandMembers                GigBandMember[]
  shareLinks                 ShareLinkGig[]
  attachments                GigAttachment[]

  @@index([userId])
  @@index([date])
  @@index([paymentReceived])
  @@index([bandPaid])
  @@index([userId, date])
  @@index([userId, paymentReceived])
  @@index([setlistId])
  @@index([bandId])
}

/// Documents (contracts, riders, invoices, photos) attached to a gig.
/// `extractedText` holds the text extracted from the file so the AI summary
/// does not have to re-download and re-parse the same document every time.
model GigAttachment {
  id           String   @id @default(cuid())
  gigId        String
  url          String   @db.Text
  storagePath  String?  @db.Text
  type         String // "pdf" | "image"
  title        String?
  description  String?
  mimeType     String?
  fileSize     Int?
  extractedText String? @db.Text
  order        Int      @default(1)
  uploadedAt   DateTime @default(now())

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId, order])
}

model Setlist {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      String?       @default("concept")
  datum       String?       // Date as string
  locatie     String?       // Location
  userId      String
  bandId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  gigs        Gig[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       SetlistItem[]
  band        bands?        @relation(fields: [bandId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([bandId])
}

model SetlistItem {
  id        String   @id @default(cuid())
  setlistId String
  order     Int
  type      String
  title     String?
  notes     String?
  chords    String?
  tuning    String?
  /// Key signature (e.g. "A", "F#m"). Powers the AI flow/key-transition analysis.
  keySignature String?
  /// Tempo in BPM. Powers the AI pacing analysis.
  bpm       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  setlist   Setlist  @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  attachments SetlistItemAttachment[]

  @@index([setlistId, order])
}

model SetlistItemAttachment {
  id           String      @id @default(cuid())
  setlistItemId String
  url          String      @db.Text
  type         String
  title        String?
  description  String?
  mimeType     String?
  fileSize     Int?
  order        Int         @default(1)
  uploadedAt   DateTime    @default(now())

  setlistItem  SetlistItem @relation(fields: [setlistItemId], references: [id], onDelete: Cascade)

  @@index([setlistItemId, order])
}

model User {
  id               String                  @id @default(cuid())
  supabaseId       String                  @unique
  email            String                  @unique
  name             String?
  superAdmin       Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  bandMembers      BandMember[]
  gigs             Gig[]
  investments      Investment[]
  notifications    Notification[]          @relation("UserNotifications")
  notificationPref NotificationPreference? @relation("UserNotificationPreference")
  setlists         Setlist[]
  shareLinks       ShareLink[]
  settings         UserSettings?
  webhooks         Webhook[]               @relation("UserWebhooks")
  songs            songs[]
  notes            PhotoNote[]
}

model PhotoNote {
  id                String   @id @default(cuid())
  userId            String
  linkedBand        String?
  photoUrl          String?  @db.Text
  photoName         String?
  photoNatural      Json?
  photoPos          Json?
  photoScale        Float    @default(1)
  notes             Json?    @default("[]")
  strokes           Json?    @default("[]")
  noteType          String   @default("photo")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([linkedBand])
  @@index([createdAt])
}

model ShareLink {
  id                 String         @id @default(cuid())
  token              String         @unique
  title              String?
  passwordHash       String?
  expiresAt          DateTime?
  visibility         Json
  userId             String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  selectionMode      String         @default("individual")
  includeArtists     String[]       @default([])
  autoIncludeNewGigs Boolean        @default(false)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gigs               ShareLinkGig[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([token])
  @@index([expiresAt])
  @@index([userId, selectionMode])
}

model ShareLinkGig {
  id          String    @id @default(cuid())
  shareLinkId String
  gigId       String
  createdAt   DateTime  @default(now())
  gig         Gig       @relation(fields: [gigId], references: [id], onDelete: Cascade)
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@unique([shareLinkId, gigId])
  @@index([shareLinkId])
  @@index([gigId])
}

model UserSettings {
  id                  String   @id @default(cuid())
  currency            String   @default("EUR")
  claimPerformanceFee Boolean  @default(true)
  claimTechnicalFee   Boolean  @default(true)
  userId              String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  theme               String   @default("system")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Custom Navigation Tabs
  customTab1          String   @default("setlists")
  customTab2          String   @default("songs")
  // Overview (Dashboard) view mode: "grid" (card grid) or "compact" (dense list)
  overviewViewMode    String   @default("grid")
  // PDF Export Settings
  pdfIncludeLogo      Boolean  @default(true)
  pdfFont             String   @default("inter")
  pdfPageSize         String   @default("a4")
  pdfPageBreakMode    String   @default("auto")
  pdfDarkMode         Boolean  @default(false)
  pdfShowHeaders      Boolean  @default(true)
  pdfShowMetadata     Boolean  @default(true)
  pdfImagesOnly       Boolean  @default(false)
  pdfShowPageNumbers  Boolean  @default(true)
  pdfMarginSize       String   @default("medium")
  // Band Settings
  excludeSelfFromMemberCount Boolean @default(false)
}

model Investment {
  id                 String   @id @default(cuid())
  amount             Float
  description        String?
  date               DateTime @default(now())
  userId             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  sharedWithMusician Boolean  @default(false)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model InvestmentContributor {
  id           String   @id @default(cuid())
  investmentId String
  bandMemberId String
  createdAt    DateTime @default(now())

  @@unique([investmentId, bandMemberId])
  @@index([investmentId])
  @@index([bandMemberId])
}

model BandMember {
  id        String          @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  avatarUrl String?
  /// Nullable: a member is created as an unclaimed record (an invitation)
  /// and only gains a userId once someone registers with that email address.
  userId    String?
  /// Whether this member may administer the band (manage invites, members and
  /// whether fellow members may edit gigs). Exactly one leader per band is the
  /// intended shape, but the model does not enforce it.
  isLeader  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  bands     String[]        @default([])
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gigs      GigBandMember[]

  @@unique([userId, name])
  @@index([userId])
  /// Claiming an invitation looks a member up by email, so this needs an index.
  @@index([email])
}

model GigBandMember {
  id                      String     @id @default(cuid())
  gigId                   String
  bandMemberId            String
  earnedAmount            Float      @default(0)
  paidAmount              Float      @default(0)
  /// RSVP / attendance status: ATTENDING, DECLINED, MAYBE, or PENDING (default).
  rsvpStatus              String     @default("PENDING")
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  customPerformanceAmount Float?
  bandMember              BandMember @relation(fields: [bandMemberId], references: [id], onDelete: Cascade)
  gig                     Gig        @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([gigId, bandMemberId])
  @@index([gigId])
  @@index([bandMemberId])
  @@index([gigId, bandMemberId])
  @@index([gigId, rsvpStatus])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  message     String
  icon        String?
  actionUrl   String?
  actionLabel String?
  status      String    @default("unread")
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  dismissedAt DateTime?
  user        User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailNotifications   Boolean  @default(true)
  inAppNotifications   Boolean  @default(true)
  paymentReminders     Boolean  @default(true)
  overdueAlerts        Boolean  @default(true)
  upcomingGigReminders Boolean  @default(true)
  dailyDigest          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation("UserNotificationPreference", fields: [userId], references: [id], onDelete: Cascade)
}

model Webhook {
  id              String       @id @default(cuid())
  userId          String
  provider        String
  url             String
  events          String[]
  enabled         Boolean      @default(true)
  name            String?
  secret          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastTriggeredAt DateTime?
  user            User         @relation("UserWebhooks", fields: [userId], references: [id], onDelete: Cascade)
  logs            WebhookLog[]

  @@index([userId, enabled])
  @@index([userId, createdAt])
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  data       String
  statusCode Int?
  response   String?
  error      String?
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([success])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model al_positions {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String
  ticker       String
  name         String?
  sector       String?
  exchange     String?
  strategyType String?  @default("long_term")
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @db.Timestamp(6)

  @@index([userId], map: "idx_al_positions_userid")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model al_settings {
  id                 String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId             String   @unique(map: "al_settings_userid_unique")
  theme              String   @default("dark")
  cashPosition       Float    @default(10000)
  defaultBrokerFee   Float    @default(5.00)
  defaultTaxRate     Float    @default(0.35)
  defaultCurrencyFee Float    @default(0)
  momentumWeight     Int      @default(30)
  fundamentalsWeight Int      @default(30)
  sentimentWeight    Int      @default(20)
  volatilityWeight   Int      @default(10)
  regimeWeight       Int      @default(10)
  notifBreakeven     Boolean  @default(true)
  notifDropAlert     Boolean  @default(true)
  notifAnalystChange Boolean  @default(true)
  apiKeyPrimary      String?  @default("")
  apiKeySecondary    String?  @default("")
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  updatedAt          DateTime @default(now()) @db.Timestamp(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model al_strategy_preferences {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String
  ticker       String
  strategyType String   @default("long_term")
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @db.Timestamp(6)

  @@unique([userId, ticker], map: "al_strategy_preferences_unique")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model al_transactions {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  positionId     String
  type           String   @default("buy")
  quantity       Float
  pricePerShare  Float
  brokerFee      Float    @default(0)
  transactionTax Float    @default(0)
  currencyFee    Float    @default(0)
  date           DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  createdAt      DateTime @default(now()) @db.Timestamp(6)

  @@index([positionId], map: "idx_al_transactions_positionid")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model al_watchlist {
  id       String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId   String
  ticker   String
  name     String?
  exchange String?
  sector   String?
  addedAt  DateTime @default(now()) @db.Timestamp(6)

  @@unique([userId, ticker], map: "al_watchlist_unique")
  @@index([userId], map: "idx_al_watchlist_userid")
}

model bands {
  id        String    @id
  name      String
  userId    String
  logoUrl   String?
  color     String?   @default("#6366f1") // Default accent color
  /// Short alphanumeric code used by the /join flow. Null until generated.
  inviteCode String?  @unique
  /// Band leader's switch: when false, linked members may read shared gigs but
  /// cannot edit them. Owners are never affected by this flag.
  canMembersEdit Boolean @default(false)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @db.Timestamptz(6)
  setlists  Setlist[]
  gigs      Gig[]
}

model song_attachments {
  id           String    @id
  songId       String
  storage_path String
  public_url   String
  content_type String
  caption      String?
  order        Int       @default(1)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  songs        songs     @relation(fields: [songId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "song_attachments_songid_fkey")

  @@index([songId], map: "idx_song_attachments_songid")
}

model song_bands {
  id        String    @id
  songId    String
  bandId    String
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
}

model song_tags {
  id        String    @id
  songId    String
  tagId     String
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
}

model songs {
  id               String             @id
  title            String
  notes            String?
  date             DateTime           @default(now()) @db.Timestamptz(6)
  userId           String
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @db.Timestamptz(6)
  deletedAt        DateTime?          @db.Timestamptz(6)
  song_attachments song_attachments[]
  User             User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "songs_userid_fkey")

  @@index([date], map: "idx_songs_date")
  @@index([userId], map: "idx_songs_userid")
}

model tags {
  id        String    @id
  name      String
  userId    String
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
}
